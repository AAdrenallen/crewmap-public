# Copy to .env (git-ignored) and fill in. Never commit .env.

# Mapbox public token (pk.…): scopes styles:read, fonts:read, datasets:read, vision:read (defaults)
MAPBOX_PUBLIC_TOKEN=pk.REPLACE_ME

# Optional paid Waze fallback (off when cap is 0)
WAZE_PAID_PROVIDER=openwebninja
WAZE_PAID_API_KEY=
WAZE_PAID_MONTHLY_CAP_USD=0

# Optional central-PC relay (only if the benchmark says so), e.g. wss://crewmap-pc.tailnet-xxxx.ts.net
CREWMAP_RELAY_URL=
# Open Charge Map (optional, free key from openchargemap.org; empty = off; D64)
OCM_API_KEY=
